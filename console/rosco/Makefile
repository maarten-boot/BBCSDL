# BBC BASIC console edition for the rosco-m68k (68010, bare metal, newlib).
# Run through dmake.sh (the rosco toolchain image):
#	./dmake.sh		build ../../build/rosco/ROSCODE1.BIN
#	./dmake.sh clean
# Spec: architecture/Spec.md (S2, S3, S5).

TOP	= ../..
OUT	= $(TOP)/build/rosco
SRC	= $(TOP)/src
CPU	= 68010

CC	= m68k-elf-rosco-gcc
OBJCOPY	= m68k-elf-rosco-objcopy
SIZE	= m68k-elf-rosco-size

CFLAGS	= -mcpu=$(CPU) -I$(TOP)/include -I. -Wall -Wno-unused-result \
	  -Wno-array-bounds -ffunction-sections -fdata-sections \
	  --param=min-pagesize=0
FAST	= -O2 -ffast-math -fno-finite-math-only
SMALL	= -Os
LDFLAGS	= -mcpu=$(CPU) -Wl,--gc-sections -Wl,-Map=$(OUT)/bbcbasic.map

OBJS	= $(addprefix $(OUT)/, bbmain.o bbexec.o bbeval.o bbccos.o \
	  bbcrosco.o posix.o bbasmb_none.o lefix.o bbdata.o)

all:	$(OUT)/ROSCODE1.BIN

$(OUT):
	mkdir -p $@

$(OUT)/bbmain.o $(OUT)/bbexec.o $(OUT)/bbeval.o: $(OUT)/%.o: $(SRC)/%.c $(TOP)/include/BBC.h $(TOP)/include/bbcplat.h | $(OUT)
	$(CC) $(CFLAGS) $(FAST) -c $< -o $@

$(OUT)/bbccos.o: $(SRC)/bbccos.c $(TOP)/include/bbccon.h $(TOP)/include/bbcplat.h | $(OUT)
	$(CC) $(CFLAGS) $(SMALL) -c $< -o $@

$(OUT)/%.o: %.c $(TOP)/include/bbccon.h $(TOP)/include/bbcplat.h | $(OUT)
	$(CC) $(CFLAGS) $(SMALL) -c $< -o $@

# bbdata.s is generated by dmake.sh on the host (tools/mkdata.py): the
# toolchain image has no Python.

$(OUT)/bbdata.o: $(OUT)/bbdata.s
	$(CC) -mcpu=$(CPU) -c $< -o $@

$(OUT)/bbcbasic.elf: $(OBJS)
	$(CC) $(LDFLAGS) $(OBJS) -lm -o $@
	$(SIZE) $@

$(OUT)/ROSCODE1.BIN: $(OUT)/bbcbasic.elf
	$(OBJCOPY) -O binary $< $@

clean:
	rm -rf $(OUT)

.PHONY: all clean
